# Copy this file to `.env` for local development.
# Never commit real secrets.

# Local PostgreSQL from docker-compose.yml (development only)
DATABASE_URL="postgresql://handyhome:handyhome@localhost:5432/handyhome"

# Playwright uses a separate database so auth E2E users never land in the demo dataset.
# Optional; defaults to the same host/user with database name handyhome_e2e.
# E2E_DATABASE_URL="postgresql://handyhome:handyhome@localhost:5432/handyhome_e2e"

# Vitest uses its own database (created, migrated and seeded automatically).
# Optional; defaults to the same host/user with database name handyhome_test.
# TEST_DATABASE_URL="postgresql://handyhome:handyhome@localhost:5432/handyhome_test"

# Better Auth (required). Must be at least 32 characters.
# Local: generate with `openssl rand -base64 32`.
# Production: set a different strong secret in the host (Vercel). Never reuse the local value. Never commit a real secret.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Hostname or IPv4 used to open the app from a phone on the LAN
# (no scheme, no port), e.g. 192.168.1.24. Local private addresses are
# detected automatically. Do not set this to a public hostname.
# DEV_PUBLIC_HOST="192.168.1.24"

# Map, media, payment, and notification provider keys are not locked.
# Do not invent vendor-specific variable names until those decisions exist.
